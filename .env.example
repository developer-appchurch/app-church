# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Conecte o banco de dados do Supabase para persistência e autenticação multi-igreja.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Web Push Notifications (VAPID)
# Chaves para envio de notificações Push automáticas aos líderes de célula.
# Se não fornecidas, o AppChurch utiliza chaves seguras pré-configuradas.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BArr7GtBm-7gONHTEsLx37pY9c0SSm7JDypNKy2ZlXygxe8_7GTpOnW10q_MBXrHUc2GCIi4NKjtArzNHxJjPB0"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:contato@appchurch.com"

# Cron Secret
# Token de proteção para a rota de verificação automática de relatórios (/api/cron/check-pending-reports)
CRON_SECRET="your-secure-cron-token"

